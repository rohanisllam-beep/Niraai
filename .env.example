# Gemini API Key for Araan chat, survey intelligence and voice streaming
GEMINI_API_KEY=
PORT=3000

# --- Optional Araan configuration (all have safe defaults) ---
# Creator credit Araan states when asked who made it. Leave unset to use the repo default,
# or set to "none" so Araan says it has no verified creator information.
# ARAAN_CREATOR=
# Models (defaults match the previous hardcoded cascade). ARAAN_QUALITY_MODEL is unset by default;
# set it only if you want a stronger (possibly paid) model for prompt-engineering / comprehensive answers.
# ARAAN_PRIMARY_MODEL=gemini-3.5-flash-lite
# ARAAN_FALLBACK_MODEL=gemini-3.1-flash-lite
# ARAAN_QUALITY_MODEL=
# ARAAN_LIVE_MODEL=gemini-3.8-live
# Cap on output tokens regardless of response mode, and temperature overrides.
# ARAAN_MAX_OUTPUT_TOKENS=
# ARAAN_TEMP_CHAT=0.7
# ARAAN_TEMP_PROMPT=0.6
# ARAAN_TEMP_SURVEY=0.35
# Set to 1 to log prompt layer names/sizes per request (never prompt text or user content).
# ARAAN_DEBUG_PROMPTS=0
